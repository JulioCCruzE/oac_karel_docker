<launch>
  <arg name="rviz" default="true"/>
  <arg name="joystick" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="emulator" default="true"/>

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find karel_gazebo)/urdf/karel.xacro'"/>

  <group if="$(arg joystick)">
    <node name="joy" pkg="joy" type="joy_node" output="screen">
      <param name="deadzone" value="0.15"/>
      <param name="autorepeat_rate" value="10.0"/>
    </node>
    <node name="karel_joystick" pkg="karel_teleop" type="karel_joystick.py" output="screen"/>
  </group>

  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find karel_bringup)/rviz/karel.rviz" output="screen"/>
  <node if="$(arg gui)" name="karel_gui" pkg="karel_gui" type="karel_gui_node"
        output="screen"/>
  <node if="$(arg emulator)" name="emulador68hc11" pkg="emulador68hc11"
        type="emulador68hc11" output="screen"/>
</launch>
