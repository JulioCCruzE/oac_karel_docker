<package format="2">
  <name>karel_gazebo</name>
  <version>1.0.0</version>
  <description>Gazebo model and simulation bring-up for the Karel robot.</description>
  <maintainer email="julioccruze@sociales.unam.mx">Julio Cruz</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>karel_evaluation</exec_depend>
  <exec_depend>rospkg</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>python-nose</test_depend>
</package>
